{
  "version": "5.1",
  "note": "Model lanes (PRD v5.1 s2c, s3). No per-token meter anywhere. A lane is ready | resting(until) | disabled; the probe (conductor/lanes.mjs probeLanes) updates state/lanes-status.json every 15 minutes. Owner decision 2026-09-15 night: Conductor's decisionModel is opus (config/company.json), NOT sonnet -- Bennett's own stack description names GLM-5.1 as his real 'Codex' (primary coding) with ChatGPT's Codex-plan as a secondary lane only, which this file now mirrors. codex-chatgpt pool (gpt-6-astra, gpt-5.5) disabled entirely: owner reports quota at 0% the evening of 2026-09-15 with cause unverified (plausible cause: 3 overlapping codex-family lanes -- gpt-6-astra, gpt-5.5, and a since-removed plain 'codex' lane -- all hammering the same shared ChatGPT-plan pool through several hours of live debugging). gpt-6-astra was already found to burn far more tokens per call than even Opus; it is not used for anything (coding or orchestration fallback) until quota is confirmed healthy and a cheaper lane genuinely needs it. Orchestrator's own fallback (when opus/sonnet are unavailable) is Hermes+Ollama GLM-5.3-flash, not Codex. kimi-k27 (Ollama) is disabled to protect the Ollama Cloud quota; kimi-k3 (Kimi Code CLI) is disabled until the monthly reset. | 2026-09-16 owner decision after GIBRAN audit: Bennett shape — GLM primary via Hermes, Codex (gpt-5.5) second lane, Claude only for decisions/review, Kimi disabled until reset, one Hermes run per pool at a time (shared HERMES_HOME session store). | 2026-09-16 13:40 owner: OpenRouter added (WORKER_POOL_OPENROUTER_API_KEY, key limit $5, prepaid $10): free lanes first (strongest free models), paid fallback, Codex stays second lane, Claude = brain.",
  "probe": {
    "intervalMinutes": 15,
    "restMinutes": 60,
    "retryAfterMinutes": 5
  },
  "semaphore": {
    "ollama-cloud-glm": 1,
    "ollama-cloud-kimi": 1,
    "codex-chatgpt": 1,
    "openrouter-free": 2,
    "openrouter-paid": 2
  },
  "lanes": {
    "claude-sonnet": {
      "runtime": "claude-cli",
      "model": "sonnet",
      "pool": "claude-subscription",
      "capabilities": [
        "decide",
        "review"
      ],
      "maxTurns": 20,
      "dailyCalls": 15,
      "endpoint": "claude -p (OAuth)"
    },
    "claude-opus": {
      "runtime": "claude-cli",
      "model": "opus",
      "pool": "claude-subscription",
      "capabilities": [
        "decide"
      ],
      "maxTurns": 20,
      "dailyCalls": 5,
      "endpoint": "claude -p (OAuth)",
      "reason": "owner decision 2026-09-15 night: orchestrator decisions run on opus per Bennett's stack, capped 5/day (config/company.json's conductor.opusTurnsPerDay) -- supersedes the earlier same-day 'opus 0/day, sonnet only' decision"
    },
    "kimi-k3": {
      "runtime": "kimi-cli",
      "model": "kimi-code/dispatch",
      "pool": "kimi-code",
      "capabilities": [
        "decide",
        "plan",
        "write",
        "review"
      ],
      "maxTurns": 40,
      "dailyTasks": 10,
      "endpoint": "kimi CLI (Kimi Code subscription, dispatch model: 65536 ctx, no always_thinking — config.toml)",
      "status": "disabled",
      "reason": "403 monthly quota exhausted 2026-09-14; reset date unknown (Ask owner)"
    },
    "gpt-6-astra": {
      "runtime": "codex-cli",
      "model": "gpt-6-astra",
      "pool": "codex-chatgpt",
      "capabilities": [
        "decide"
      ],
      "maxTurns": 40,
      "dailyTasks": 30,
      "endpoint": "codex exec (ChatGPT plan)",
      "status": "disabled",
      "reason": "owner decision 2026-09-15 night: burns far more tokens per call than opus even, AND codex-chatgpt pool quota reported at 0% -- disabled entirely, not used for coding or orchestration fallback anymore"
    },
    "gpt-5.5": {
      "runtime": "codex-cli",
      "model": "gpt-5.5",
      "pool": "codex-chatgpt",
      "timeoutMinutes": 30,
      "capabilities": [
        "decide",
        "plan",
        "write",
        "review",
        "code"
      ],
      "maxTurns": 60,
      "dailyTasks": 45,
      "endpoint": "codex exec (ChatGPT plan)",
      "reason": "re-enabled 2026-09-16: the 401s were a SYSTEM-profile auth gap, not quota; CODEX_HOME=D:/aidit-codex-machine verified with a PONG"
    },
    "kimi-k27": {
      "runtime": "hermes-cli",
      "model": "kimi-k2.7-code:cloud",
      "pool": "ollama-cloud-kimi",
      "capabilities": [
        "code",
        "write",
        "review",
        "plan"
      ],
      "endpoint": "hermes -z (Ollama Cloud via 127.0.0.1:11434)",
      "status": "disabled",
      "reason": "owner decision 2026-09-15: kimi via Ollama off to protect Ollama Cloud quota"
    },
    "glm-52": {
      "runtime": "hermes-cli",
      "model": "glm-5.2:cloud",
      "pool": "ollama-cloud-glm",
      "timeoutMinutes": 40,
      "capabilities": [
        "write",
        "plan",
        "review",
        "code",
        "decide"
      ],
      "endpoint": "hermes -z (Ollama Cloud via 127.0.0.1:11434)",
      "status": "disabled",
      "reason": "2026-09-17: Ollama lokal mati (port 11434 tidak listen) dan owner memutuskan melepas Ollama; lane or-* OpenRouter menggantikannya"
    },
    "glm-51": {
      "runtime": "hermes-cli",
      "model": "glm-5.1:cloud",
      "pool": "ollama-cloud-glm",
      "timeoutMinutes": 30,
      "capabilities": [
        "code",
        "write"
      ],
      "endpoint": "hermes -z (Ollama Cloud via 127.0.0.1:11434)",
      "status": "disabled",
      "reason": "2026-09-17: Ollama lokal mati (port 11434 tidak listen) dan owner memutuskan melepas Ollama; lane or-* OpenRouter menggantikannya"
    },
    "glm-53-flash": {
      "runtime": "hermes-cli",
      "model": "glm-5.3-flash:cloud",
      "pool": "ollama-cloud-glm",
      "timeoutMinutes": 10,
      "capabilities": [
        "light",
        "decide"
      ],
      "endpoint": "hermes -z (Ollama Cloud via 127.0.0.1:11434)",
      "status": "disabled",
      "reason": "2026-09-17: Ollama lokal mati (port 11434 tidak listen) dan owner memutuskan melepas Ollama; lane or-* OpenRouter menggantikannya"
    },
    "or-nemotron-free": {
      "runtime": "hermes-cli",
      "provider": "openrouter",
      "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
      "pool": "openrouter-free",
      "capabilities": [
        "code",
        "write",
        "review",
        "plan"
      ],
      "maxSteps": 80,
      "timeoutMinutes": 30,
      "endpoint": "https://openrouter.ai/api/v1 via Hermes"
    },
    "or-laguna-free": {
      "runtime": "hermes-cli",
      "provider": "openrouter",
      "model": "poolside/laguna-s-2.1:free",
      "pool": "openrouter-free",
      "capabilities": [
        "code",
        "write"
      ],
      "maxSteps": 80,
      "timeoutMinutes": 30,
      "endpoint": "https://openrouter.ai/api/v1 via Hermes"
    },
    "or-gemma-free": {
      "runtime": "hermes-cli",
      "provider": "openrouter",
      "model": "google/gemma-4-31b-it:free",
      "pool": "openrouter-free",
      "capabilities": [
        "write",
        "review",
        "plan",
        "light"
      ],
      "maxSteps": 80,
      "timeoutMinutes": 30,
      "endpoint": "https://openrouter.ai/api/v1 via Hermes"
    },
    "or-glm52-free": {
      "runtime": "hermes-cli",
      "provider": "openrouter",
      "model": "z-ai/glm-5.2:free",
      "pool": "openrouter-free",
      "capabilities": [
        "decide",
        "plan"
      ],
      "maxSteps": 80,
      "timeoutMinutes": 30,
      "endpoint": "https://openrouter.ai/api/v1 via Hermes",
      "note": "32K ctx, no tools: Conductor routine/JSON only"
    },
    "or-deepseek-flash": {
      "runtime": "hermes-cli",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",
      "pool": "openrouter-paid",
      "capabilities": [
        "code",
        "write",
        "review",
        "plan"
      ],
      "maxSteps": 80,
      "timeoutMinutes": 30,
      "endpoint": "https://openrouter.ai/api/v1 via Hermes",
      "priceIn": 0.09,
      "priceOut": 0.18
    },
    "or-glm53-flash": {
      "runtime": "hermes-cli",
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flash",
      "pool": "openrouter-paid",
      "capabilities": [
        "code",
        "write",
        "review",
        "plan"
      ],
      "maxSteps": 80,
      "timeoutMinutes": 30,
      "endpoint": "https://openrouter.ai/api/v1 via Hermes",
      "priceIn": 0.1,
      "priceOut": 0.33
    },
    "or-qwen-coder": {
      "runtime": "hermes-cli",
      "provider": "openrouter",
      "model": "qwen/qwen3-coder-next",
      "pool": "openrouter-paid",
      "capabilities": [
        "code",
        "review"
      ],
      "maxSteps": 80,
      "timeoutMinutes": 30,
      "endpoint": "https://openrouter.ai/api/v1 via Hermes",
      "priceIn": 0.12,
      "priceOut": 0.8
    },
    "or-kimi-k27": {
      "runtime": "hermes-cli",
      "provider": "openrouter",
      "model": "moonshotai/kimi-k2.7-code",
      "pool": "openrouter-paid",
      "capabilities": [
        "code",
        "review",
        "plan"
      ],
      "maxSteps": 80,
      "timeoutMinutes": 30,
      "endpoint": "https://openrouter.ai/api/v1 via Hermes",
      "priceIn": 0.71,
      "priceOut": 3.21,
      "note": "berat saja"
    }
  },
  "roles": {
    "conductor-routine": [
      "or-glm52-free",
      "glm-52",
      "glm-51",
      "glm-53-flash"
    ],
    "conductor-decision": [
      "claude-sonnet",
      "or-glm52-free",
      "glm-52"
    ],
    "review": [
      "claude-sonnet",
      "or-nemotron-free",
      "or-deepseek-flash"
    ],
    "head-claude": [
      "gpt-5.5",
      "or-nemotron-free",
      "or-laguna-free",
      "or-gemma-free",
      "or-deepseek-flash",
      "or-glm53-flash",
      "or-qwen-coder",
      "glm-52"
    ],
    "head-other": [
      "or-nemotron-free",
      "or-laguna-free",
      "or-gemma-free",
      "or-deepseek-flash",
      "or-glm53-flash",
      "or-qwen-coder",
      "glm-52",
      "glm-51"
    ],
    "worker": [
      "gpt-5.5",
      "or-nemotron-free",
      "or-laguna-free",
      "or-gemma-free",
      "or-deepseek-flash",
      "or-glm53-flash",
      "or-qwen-coder",
      "or-kimi-k27",
      "glm-51"
    ],
    "berat": [
      "or-nemotron-free",
      "or-laguna-free",
      "or-gemma-free",
      "or-kimi-k27",
      "or-deepseek-flash",
      "or-glm53-flash",
      "or-qwen-coder",
      "glm-52"
    ],
    "light": [
      "or-gemma-free",
      "glm-53-flash",
      "glm-51"
    ]
  },
  "pools": {
    "openrouter-paid": {
      "dailyUsd": 1.5,
      "keyEnv": "WORKER_POOL_OPENROUTER_API_KEY",
      "keyLimitUsd": 5
    },
    "openrouter-free": {
      "rpm": 20,
      "rpd": 1000
    }
  }
}
