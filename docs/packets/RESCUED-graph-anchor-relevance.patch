+function graphAnchorTextShape(value) {
+  return String(value || "")
+    .replace(/([A-Z]+)([A-Z][a-z])/g, "$1 $2")
+    .replace(/([a-z0-9])([A-Z])/g, "$1 $2")
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+function graphAnchorLabelTokens(label) {
+  return graphAnchorTextShape(label)
+    .split(" ")
+    .filter((t) => t.length >= 2);
+}
+
+export function graphAnchorRelevanceScore(node, planText = "") {
+  const label = compactGraphAnchorText(node?.label || node?.name || node?.title || node?.id);
+  if (!label) return 0;
+  const rawPlan = String(planText || "").toLowerCase();
+  const rawLabel = String(label).toLowerCase();
+  const shapedPlan = graphAnchorTextShape(planText);
+  const shapedLabel = graphAnchorTextShape(label);
+  const tokens = graphAnchorLabelTokens(label);
+
+  if (rawLabel && rawPlan.includes(rawLabel)) {
+    return (tokens.length > 1 ? 2000 : 800) + tokens.length * 20 + rawLabel.length;
+  }
+  if (shapedLabel && shapedPlan.includes(shapedLabel)) {
+    return (tokens.length > 1 ? 1000 : 500) + tokens.length * 20 + shapedLabel.length;
+  }
+  if (!tokens.length) return 0;
+  if (tokens.every((t) => shapedPlan.includes(t))) return 600 + tokens.length * 10;
+  return tokens.reduce((score, token) => score + (shapedPlan.includes(token) ? 10 : 0), 0);
+}
