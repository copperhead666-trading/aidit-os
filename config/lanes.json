{
  "version": "5.1",
  "note": "Model lanes (PRD v5.1 s2c, s3). No per-token meter anywhere. A lane is ready | resting(until) | disabled; the probe (conductor/lanes.mjs probeLanes) updates state/lanes-status.json every 15 minutes. Claude lanes are reserved for conductor-decision and review only (owner decision 2026-09-15) — heads and workers never use claude-*. kimi-k27 (Ollama) is disabled to protect the Ollama Cloud quota; kimi-k3 (Kimi Code CLI) is disabled until the monthly reset.",
  "probe": { "intervalMinutes": 15, "restMinutes": 60, "retryAfterMinutes": 5 },
  "semaphore": { "ollama-cloud-glm": 2, "ollama-cloud-kimi": 2 },
  "lanes": {
    "claude-sonnet": { "runtime": "claude-cli", "model": "sonnet", "pool": "claude-subscription", "capabilities": ["decide", "review"], "maxTurns": 20, "dailyCalls": 15, "endpoint": "claude -p (OAuth)" },
    "claude-opus": { "runtime": "claude-cli", "model": "opus", "pool": "claude-subscription", "capabilities": ["decide"], "maxTurns": 20, "dailyCalls": 0, "endpoint": "claude -p (OAuth)", "status": "disabled", "reason": "owner decision 2026-09-15: opus 0/day, decision role runs on sonnet" },
    "kimi-k3": { "runtime": "kimi-cli", "model": "kimi-code/dispatch", "pool": "kimi-code", "capabilities": ["decide", "plan", "write", "review"], "maxTurns": 40, "dailyTasks": 10, "endpoint": "kimi CLI (Kimi Code subscription, dispatch model: 65536 ctx, no always_thinking — config.toml)", "status": "disabled", "reason": "403 monthly quota exhausted 2026-09-14; reset date unknown (Ask owner)" },
    "gpt-6-astra": { "runtime": "codex-cli", "model": "gpt-6-astra", "pool": "codex-chatgpt", "capabilities": ["decide", "plan", "write", "review", "code"], "maxTurns": 60, "dailyTasks": 30, "endpoint": "codex exec (ChatGPT plan)" },
    "codex": { "runtime": "codex-cli", "model": "default", "pool": "codex-chatgpt", "capabilities": ["code", "review"], "maxTurns": 80, "dailyTasks": 30, "endpoint": "codex exec (ChatGPT plan)" },
    "kimi-k27": { "runtime": "hermes-cli", "model": "kimi-k2.7-code:cloud", "pool": "ollama-cloud-kimi", "capabilities": ["code", "write", "review", "plan"], "endpoint": "hermes -z (Ollama Cloud via 127.0.0.1:11434)", "status": "disabled", "reason": "owner decision 2026-09-15: kimi via Ollama off to protect Ollama Cloud quota" },
    "glm-52": { "runtime": "hermes-cli", "model": "glm-5.2:cloud", "pool": "ollama-cloud-glm", "capabilities": ["write", "plan", "review", "code", "decide"], "endpoint": "hermes -z (Ollama Cloud via 127.0.0.1:11434)" },
    "glm-51": { "runtime": "hermes-cli", "model": "glm-5.1:cloud", "pool": "ollama-cloud-glm", "capabilities": ["code", "write"], "endpoint": "hermes -z (Ollama Cloud via 127.0.0.1:11434)" },
    "glm-53-flash": { "runtime": "hermes-cli", "model": "glm-5.3-flash:cloud", "pool": "ollama-cloud-glm", "capabilities": ["light"], "endpoint": "hermes -z (Ollama Cloud via 127.0.0.1:11434)" }
  },
  "roles": {
    "conductor-routine": ["glm-52", "glm-51", "claude-sonnet"],
    "conductor-decision": ["claude-sonnet", "glm-52"],
    "review": ["claude-sonnet", "glm-52"],
    "head-claude": ["gpt-6-astra", "kimi-k3", "glm-51", "codex"],
    "head-other": ["gpt-6-astra", "kimi-k3", "glm-52", "kimi-k27", "codex"],
    "worker": ["gpt-6-astra", "codex", "kimi-k3", "glm-51"],
    "berat": ["glm-52", "glm-51", "gpt-6-astra", "codex", "kimi-k3"],
    "light": ["glm-53-flash", "glm-51"]
  }
}
